{
	"name": "Anchorage",
	"image": "mcr.microsoft.com/devcontainers/go:2-1.27-trixie",
	"remoteUser": "vscode",
	"initializeCommand": [
		"sh",
		"${localWorkspaceFolder}/oci/volume.sh",
		"sha256:727ee1a63b344f79a136ca1762eaca603d32a7d404ee48a0bb405a18004d6246"
	],
	"mounts": [
		"type=volume,source=anchorage-tools-727ee1a63b344f79a136ca1762eaca603d32a7d404ee48a0bb405a18004d6246,target=/opt/workharbor,readonly,volume-nocopy",
		"type=volume,source=anchorage-home-${devcontainerId},target=/home/vscode"
	],
	"containerEnv": {
		"GOFLAGS": "-trimpath",
		"DISABLE_UPDATES": "1",
		"DISABLE_AUTOUPDATER": "1",
		"SHELL": "/bin/bash"
	},
	"remoteEnv": {
		"PATH": "/opt/workharbor/bin:${containerEnv:PATH}"
	},
	"postCreateCommand": "sh .devcontainer/setup.sh",
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.profiles.linux": {
					"Fish": {
						"path": "/opt/workharbor/bin/fish"
					},
					"Herdr": {
						"path": "/opt/workharbor/bin/herdr"
					},
					"Bash": {
						"path": "/bin/bash"
					}
				},
				"terminal.integrated.defaultProfile.linux": "Fish",
				"terminal.integrated.automationProfile.linux": {
					"path": "/bin/bash"
				}
			}
		}
	}
}
