{
	"name": "Anchorage",
	"image": "mcr.microsoft.com/devcontainers/go:2-1.27-trixie",
	"remoteUser": "vscode",
	"initializeCommand": [
		"sh",
		"${localWorkspaceFolder}/oci/volume.sh",
		"sha256:7a13739dbb4155d4f556234afc33591084f06c440749225e71b9e0d54d51a6c4"
	],
	"mounts": [
		"type=volume,source=anchorage-tools-7a13739dbb4155d4f556234afc33591084f06c440749225e71b9e0d54d51a6c4,target=/opt/workharbor,readonly,volume-nocopy",
		"type=volume,source=anchorage-home-${devcontainerId},target=/home/vscode"
	],
	"containerEnv": {
		"GOFLAGS": "-trimpath",
		"DISABLE_UPDATES": "1",
		"DISABLE_AUTOUPDATER": "1"
	},
	"remoteEnv": {
		"PATH": "/opt/workharbor/bin:${containerEnv:PATH}"
	}
}
