{
  "schema": 1,
  "packages": {
    "codex": {
      "provider": "github",
      "repository": "openai/codex",
      "tag_prefix": "rust-v",
      "normalization": "semver",
      "architectures": {
        "amd64": "x86_64",
        "arm64": "aarch64"
      },
      "asset": "codex-package-{arch}-unknown-linux-musl.tar.gz",
      "allowed_hosts": [
        "github.com"
      ],
      "verification": "official-or-download",
      "install": {
        "kind": "tar.gz",
        "members": {
          "bin/codex": "bin/codex"
        },
        "preserve": true,
        "exclude_directories": [
          "codex-resources/voice"
        ]
      },
      "sidecar": "{asset}.sha256",
      "notices": [
        "licenses/codex/LICENSE",
        "licenses/codex/NOTICE",
        "licenses/codex/SOURCE"
      ]
    }
  }
}
