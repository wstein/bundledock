{
  "schema": 1,
  "packages": {
    "ast-grep": {
      "provider": "github",
      "repository": "ast-grep/ast-grep",
      "normalization": "semver",
      "architectures": {
        "amd64": "x86_64",
        "arm64": "aarch64"
      },
      "asset": "app-{arch}-unknown-linux-gnu.zip",
      "allowed_hosts": [
        "github.com"
      ],
      "verification": "official-or-download",
      "install": {
        "kind": "zip",
        "members": {
          "ast-grep": "bin/ast-grep"
        }
      },
      "notices": [
        "licenses/ast-grep/LICENSE",
        "licenses/ast-grep/SOURCE"
      ]
    },
    "delta": {
      "provider": "github",
      "repository": "dandavison/delta",
      "normalization": "semver",
      "architectures": {
        "amd64": "x86_64-unknown-linux-musl",
        "arm64": "aarch64-unknown-linux-gnu"
      },
      "asset": "delta-{version}-{arch}.tar.gz",
      "allowed_hosts": [
        "github.com"
      ],
      "verification": "official-or-download",
      "install": {
        "kind": "tar.gz",
        "members": {
          "delta": "bin/delta"
        },
        "archive_notices": [
          "LICENSE"
        ]
      },
      "notices": [
        "licenses/delta/SOURCE",
        "licenses/delta/bat-LICENSE-APACHE",
        "licenses/delta/bat-LICENSE-MIT",
        "licenses/delta/bat-NOTICE",
        "licenses/delta/bat-SYNTAX-THEME-INVENTORY",
        "licenses/delta/bat-SYNTAX-THEME-NOTICES",
        "licenses/delta/src--utils--bat--LICENSE"
      ]
    },
    "difftastic": {
      "provider": "github",
      "repository": "Wilfred/difftastic",
      "normalization": "semver",
      "architectures": {
        "amd64": "x86_64-unknown-linux-musl",
        "arm64": "aarch64-unknown-linux-gnu"
      },
      "asset": "difft-{version}-{arch}.tar.gz",
      "allowed_hosts": [
        "github.com"
      ],
      "verification": "official-or-download",
      "install": {
        "kind": "tar.gz",
        "members": {
          "difft": "bin/difft"
        }
      },
      "notices": [
        "licenses/difftastic/LICENSE",
        "licenses/difftastic/SOURCE"
      ]
