        "kind": "tar.gz",
        "members": {
          "fastfetch": "bin/fastfetch"
        }
      },
      "notices": [
        "licenses/fastfetch/LICENSE",
        "licenses/fastfetch/YYJSON-LICENSE",
        "licenses/fastfetch/WIDECHAR-LICENSE",
        "licenses/fastfetch/UNICODE-LICENSE",
        "licenses/fastfetch/SOURCE"
      ]
    },
    "helix": {
      "provider": "github",
      "repository": "helix-editor/helix",
      "normalization": "helix-calendar",
      "architectures": {
        "amd64": "x86_64",
        "arm64": "aarch64"
      },
      "asset": "helix-{version}-{arch}-linux.tar.xz",
      "allowed_hosts": [
        "github.com"
      ],
      "verification": "official-or-download",
      "install": {
        "kind": "tar.xz",
